{
  "note": "國際指標 -> 台股類股/題材對應規則（初版，全部待審）。理由是可被質疑的經驗假設，不是保證；請逐條審過再把 status 改為「已審」。status「待審-缺資料」代表需要 pilot 先新增該指標。",
  "rules": [
    {"id": "sox-up-semi", "when": {"key": "sox", "op": ">=", "pct": 2}, "targets": [{"type": "theme", "name": "晶圓代工"}, {"type": "theme", "name": "IC設計"}, {"type": "theme", "name": "封裝測試"}], "dir": "up", "why": "費半是台灣半導體的同業參考；大漲時次日晶圓代工、IC設計常同向開盤，但幅度不一定跟上。", "status": "待審"},
    {"id": "sox-down-semi", "when": {"key": "sox", "op": "<=", "pct": -2}, "targets": [{"type": "theme", "name": "晶圓代工"}, {"type": "theme", "name": "IC設計"}, {"type": "theme", "name": "封裝測試"}], "dir": "down", "why": "費半重挫時，外資與電子權值股常跟著降風險，次日半導體偏弱開出的機率較高。", "status": "待審"},
    {"id": "sox-up-equip", "when": {"key": "sox", "op": ">=", "pct": 3}, "targets": [{"type": "theme", "name": "半導體設備材料"}], "dir": "up", "why": "費半單日大漲通常伴隨資本支出或 AI 需求題材，設備材料股的情緒較敏感。", "status": "待審"},
    {"id": "sox-up-memory", "when": {"key": "sox", "op": ">=", "pct": 2}, "targets": [{"type": "theme", "name": "記憶體"}], "dir": "up", "why": "費半成分含美光等記憶體廠，其強勢可能帶動台灣記憶體族群，但記憶體另有自身報價週期。", "status": "待審"},
    {"id": "sox-down-memory", "when": {"key": "sox", "op": "<=", "pct": -3}, "targets": [{"type": "theme", "name": "記憶體"}], "dir": "down", "why": "費半急跌時高 beta 的記憶體股常放大跌幅，屬情緒連動而非基本面。", "status": "待審"},
    {"id": "ixic-up-ai", "when": {"key": "ixic", "op": ">=", "pct": 1.5}, "targets": [{"type": "theme", "name": "AI伺服器／ODM"}, {"type": "theme", "name": "散熱"}, {"type": "theme", "name": "光通訊"}], "dir": "up", "why": "那斯達克偏重科技與 AI 大型股，強勢時台灣 AI 供應鏈常有題材共振。", "status": "待審"},
    {"id": "ixic-down-ai", "when": {"key": "ixic", "op": "<=", "pct": -1.5}, "targets": [{"type": "theme", "name": "AI伺服器／ODM"}, {"type": "theme", "name": "散熱"}, {"type": "theme", "name": "光通訊"}], "dir": "down", "why": "那斯達克重挫代表美國科技股風險偏好下降，AI 供應鏈的追價意願可能轉弱。", "status": "待審"},
    {"id": "ixic-up-apple", "when": {"key": "ixic", "op": ">=", "pct": 2}, "targets": [{"type": "theme", "name": "蘋果供應鏈"}], "dir": "up", "why": "蘋果是那斯達克權重股，大漲日蘋果鏈有時同步受惠；但個股消息影響更大。", "status": "待審"},
    {"id": "spx-down-broad", "when": {"key": "spx", "op": "<=", "pct": -1.5}, "targets": [{"type": "sector", "name": "電子零組件業"}, {"type": "sector", "name": "電腦及週邊設備"}, {"type": "sector", "name": "光電業"}], "dir": "down", "why": "標普大跌常反映全球風險趨避，外資在台灣電子出貨的機率提高，電子類股通常先承壓。", "status": "待審"},
    {"id": "spx-up-broad", "when": {"key": "spx", "op": ">=", "pct": 1.5}, "targets": [{"type": "sector", "name": "電子零組件業"}, {"type": "sector", "name": "電腦及週邊設備"}], "dir": "up", "why": "標普大漲代表風險偏好回升，台灣電子出口導向類股多半同向，但常已提前反映在夜盤。", "status": "待審"},
    {"id": "dji-up-cyclical", "when": {"key": "dji", "op": ">=", "pct": 1.5}, "targets": [{"type": "sector", "name": "航運業"}, {"type": "sector", "name": "鋼鐵工業"}, {"type": "sector", "name": "電機機械"}], "dir": "up", "why": "道瓊偏傳統景氣循環股，大漲暗示景氣預期轉佳，台灣循環類股可能受惠；關聯較弱。", "status": "待審"},
    {"id": "dji-down-fin", "when": {"key": "dji", "op": "<=", "pct": -1.5}, "targets": [{"type": "theme", "name": "金控"}], "dir": "down", "why": "道瓊重挫時全球金融股風險偏好下降，台灣金控的海外部位與評價可能受壓。", "status": "待審"},
    {"id": "txfn-up-broad", "when": {"key": "txf_night", "op": ">=", "pct": 1}, "targets": [{"type": "sector", "name": "半導體業"}, {"type": "sector", "name": "電子零組件業"}], "dir": "up", "why": "台指期夜盤直接反映美股與當晚消息，電子權值股是指數主要貢獻者，次日日盤常延續方向。", "status": "待審"},
    {"id": "txfn-down-broad", "when": {"key": "txf_night", "op": "<=", "pct": -1}, "targets": [{"type": "sector", "name": "半導體業"}, {"type": "sector", "name": "電子零組件業"}], "dir": "down", "why": "夜盤下跌代表次日日盤偏弱開出的預期，權值電子股首當其衝，但日盤可能收斂跌幅。", "status": "待審"},
    {"id": "txf-up-fin", "when": {"key": "txf", "op": ">=", "pct": 1.5}, "targets": [{"type": "theme", "name": "金控"}], "dir": "up", "why": "台指期日盤大漲時成交量放大，金控與券商類常有輪動補漲，屬弱關聯假設。", "status": "待審"},
    {"id": "tsmadr-up-foundry", "when": {"key": "tsm_adr", "op": ">=", "pct": 2}, "targets": [{"type": "code", "name": "2330"}, {"type": "theme", "name": "晶圓代工"}], "dir": "up", "why": "台積電 ADR 與台股 2330 同一標的，ADR 夜間漲幅是次日 2330 開盤的直接參考（需扣除匯率與折溢價）。", "status": "待審-缺資料"},
    {"id": "tsmadr-down-foundry", "when": {"key": "tsm_adr", "op": "<=", "pct": -2}, "targets": [{"type": "code", "name": "2330"}, {"type": "theme", "name": "晶圓代工"}], "dir": "down", "why": "台積電 ADR 下跌通常預示次日 2330 開低，權值股也會拖累大盤。", "status": "待審-缺資料"},
    {"id": "nvda-up-ai", "when": {"key": "nvda", "op": ">=", "pct": 3}, "targets": [{"type": "theme", "name": "AI伺服器／ODM"}, {"type": "theme", "name": "散熱"}, {"type": "theme", "name": "PCB（印刷電路板）"}], "dir": "up", "why": "輝達是 AI 伺服器需求的風向球，大漲常帶動台灣組裝、散熱、板卡供應鏈題材。", "status": "待審-缺資料"},
    {"id": "wti-up-petchem", "when": {"key": "wti", "op": ">=", "pct": 3}, "targets": [{"type": "sector", "name": "塑膠工業"}, {"type": "sector", "name": "化學工業"}], "dir": "up", "why": "原油大漲可能推升石化產品報價與庫存評價，石化股偶有同向反應；成本面亦可能受壓，方向不確定。", "status": "待審-缺資料"}
  ]
}
